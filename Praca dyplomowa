import math
import secrets
import string

# Zestawy znaków wykorzystywane w obliczeniach (zgodnie z założeniami w rozdziale 4.1)
CHARSETS = {
    "lower": string.ascii_lowercase,                          # 26 znaków
    "alnum": string.ascii_letters + string.digits,            # 62 znaki
    "full": string.ascii_letters + string.digits + string.punctuation,  # 94 znaki
}

TRIES_PER_SEC_DEFAULT = 1e9  # 1×10^9 prób/s


def entropy(length: int, charset_size: int) -> float:
    """H = L × log2(N)"""
    return length * math.log2(charset_size)


def time_to_crack_seconds(entropy_bits: float, tries_per_sec: float = TRIES_PER_SEC_DEFAULT) -> float:
    """T = 2^(H-1) / R"""
    avg_tries = 2 ** (entropy_bits - 1)
    return avg_tries / tries_per_sec


def format_seconds(seconds: float) -> str:
    """Formatowanie czasu do postaci czytelnej (sekundy/minuty/godziny/dni/lata)."""
    if seconds < 1e-3:
        return f"{seconds * 1e6:.2f} µs"
    if seconds < 1:
        return f"{seconds * 1e3:.2f} ms"

    minute = 60
    hour = 3600
    day = 86400
    year = 365.25 * day

    if seconds < minute:
        return f"{seconds:.2f} s"
    if seconds < hour:
        return f"{seconds / minute:.2f} min"
    if seconds < day:
        return f"{seconds / hour:.2f} h"
    if seconds < year:
        return f"{seconds / day:.2f} dni"
    return f"{seconds / year:.2e} lat"


def generate_password(length: int, charset_key: str = "full", ensure_diversity: bool = True) -> str:
    """
    Generator haseł z użyciem secrets (losowanie kryptograficzne).
    Dla charset_key="full" można wymusić, aby w haśle znalazły się:
    mała litera, duża litera, cyfra i znak specjalny.
    """
    charset = CHARSETS[charset_key]

    if charset_key != "full" or not ensure_diversity or length < 4:
        return "".join(secrets.choice(charset) for _ in range(length))

    parts = [
        secrets.choice(string.ascii_lowercase),
        secrets.choice(string.ascii_uppercase),
        secrets.choice(string.digits),
        secrets.choice(string.punctuation),
    ]
    parts += [secrets.choice(charset) for _ in range(length - 4)]
    secrets.SystemRandom().shuffle(parts)
    return "".join(parts)


def evaluate_case(password: str, charset_size: int, tries_per_sec: float = TRIES_PER_SEC_DEFAULT):
    L = len(password)
    H = entropy(L, charset_size)
    sec = time_to_crack_seconds(H, tries_per_sec)
    return L, H, sec


if __name__ == "__main__":
    # Hasła proste, często spotykane w praktyce
    weak_examples = [
        ("password1", 62),
        ("haslo123", 62),
        ("qwertyui", 26),
        ("kochamcie", 26),
    ]

    # Hasła mieszane (większe N, typowe dla wymuszeń polityk haseł)
    mixed_examples = [
        ("Passw0rd!", 94),
        ("random12AB!$", 94),
    ]

    # Hasła generowane automatycznie (pełny zestaw 94)
    generated_examples = [
        (generate_password(12, "full"), 94),
        (generate_password(16, "full"), 94),
        (generate_password(20, "full"), 94),
    ]

    all_cases = weak_examples + mixed_examples + generated_examples

    print(f"Założona moc atakującego: R = {TRIES_PER_SEC_DEFAULT:.1e} prób/s\n")
    print(f"{'hasło':28} {'L':>3} {'N':>3} {'H [bity]':>10} {'czas [s]':>12} {'czas (opis)':>14}")
    print("-" * 85)

    for pw, N in all_cases:
        L, H, sec = evaluate_case(pw, N)
        print(f"{pw[:28]:28} {L:>3} {N:>3} {H:>10.1f} {sec:>12.2e} {format_seconds(sec):>14}")

